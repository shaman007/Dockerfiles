{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitAuthor": "Andrey Bondarenko <me@andreybondarenko.com>",
  "prHourlyLimit": 0,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "ignorePaths": ["DEPRECATED/**"],
  "packageRules": [
    {
      "description": "Merge container image updates after all checks pass",
      "matchDatasources": ["docker"]
    },
    {
      "description": "Track the derived Dawarich image base",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["freikin/dawarich"],
      "groupName": "Dawarich base image"
    }
  ]
}
